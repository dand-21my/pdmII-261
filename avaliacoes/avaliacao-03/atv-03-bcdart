import 'dart:async';

class Aluno {
  final int id;
  final String nome;
  final String curso;

  Aluno({required this.id, required this.nome, required this.curso});

  @override
  String toString() => 'ID: $id | Nome: $nome | Curso: $curso';
}

class BancoSimulado {
  final List<Aluno> _tabelaAlunos = [];
  int _idCount = 1;

  Future<void> inicializar() async {
    await Future.delayed(Duration(milliseconds: 200));
    print('Banco de dados alunos.db e tabela tb_alunos inicializados.');
  }

  Future<void> inserir(String nome, String curso) async {
    await Future.delayed(Duration(milliseconds: 100));
    if (nome.trim().isEmpty || curso.trim().isEmpty) {
      throw ArgumentError('Nome e curso são obrigatórios.');
    }
    _tabelaAlunos.add(Aluno(id: _idCount++, nome: nome, curso: curso));
  }

  Future<List<Aluno>> listar() async {
    await Future.delayed(Duration(milliseconds: 100));
    return List.unmodifiable(_tabelaAlunos);
  }
}






