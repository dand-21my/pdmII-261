import 'dart:convert';
import 'dart:io';

String situacao(double media, int faltas) {
  if (faltas > 20) return 'Reprovado por Faltas';
  if (media < 6.0) return 'Reprovado';
  return 'Aprovado';
}

Future<void> main() async {
  final client = HttpClient();

  try {
    final request = await client.getUrl(
      Uri.parse('http://localhost:8080/api/alunos'),
    );
    final response = await request.close();

    if (response.statusCode != 200) {
      print('Erro ao acessar o servidor: ${response.statusCode}');
      return;
    }

    final body = await response.transform(utf8.decoder).join();
    final json = jsonDecode(body) as Map<String, dynamic>;
    final dados = (json['dados'] as List).cast<Map<String, dynamic>>();

    print('ID  NOME            DISCIPLINA           MEDIA  FALTAS  MENSAGEM');
    print('-' * 72);

    for (final aluno in dados) {
      final id = aluno['id'] as int;
      final nome = aluno['nome'] as String;
      final disciplina = aluno['disciplina'] as String;
      final media = (aluno['media'] as num).toDouble();
      final faltas = aluno['faltas'] as int;

      print(
        '${id.toString().padRight(3)} '
        '${nome.padRight(15)} '
        '${disciplina.padRight(20)} '
        '${media.toStringAsFixed(1).padRight(6)} '
        '${faltas.toString().padRight(7)} '
        '${situacao(media, faltas)}',
      );
    }
  } on SocketException {
    print('Não foi possível conectar ao servidor. Ele está rodando?');
  } finally {
    client.close();
  }
}
